@model NC_26.Models.Group

@{
    ViewData["Title"] = "Details";
}

<h1>Details - @DateTime.Now.ToString("HH:mm:ss") </h1>

<div>
    <h4>Group</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Field)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Field.Name)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Students)
        </dt>
        <dd class="col-sm-10">
            <ul>
                @foreach (var student in Model.Students)
                {
                    <li>
                        @student.IN
                    </li>
                }
            </ul>
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Courses)
        </dt>
        <dd class="col-sm-10">
            <ul>
                @foreach (var course in Model.Courses)
                {
                    if (ViewBag.courseid != course.Id)
                    {
                        @await Component.InvokeAsync("Attendance", new { id = Model.Id, courseid = course.Id })
                    }
                    else
                    {
                        @await Component.InvokeAsync("Attendance", new { id = Model.Id, courseid = course.Id, typ = ViewBag.typ })
                    }
                    <hr />
                }
            </ul>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-info">Back to List</a>
</div>
