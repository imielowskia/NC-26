@model IEnumerable<NC_26.Models.Group>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-sm btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Field)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Students)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Courses)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Field.Name)
            </td>
            <td>
                <ul>
                    @foreach (var student in item.Students)
                        {
                            <li>
                                @student.IN
                            </li>
                        }
                </ul>
            </td>
            <td>
                <ul>
                    @foreach (var course in item.Courses)
                        {
                            <li>
                                @course.Name
                            </li>
                        }
                </ul>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary" >Edit</a> 
                <a asp-action="Details" asp-route-id="@item.Id"  class="btn btn-sm btn-secondary">Details</a> 
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
