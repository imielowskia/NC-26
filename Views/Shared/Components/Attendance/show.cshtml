<div class="row bg-body-secondary">
    <div class="col">
        @ViewBag.course.Name
    </div>
    <div class="col">
        <a asp-action="Details" asp-route-id="@ViewBag.group.Id" asp-route-courseid="@ViewBag.course.Id" asp-route-typ="add" class="btn btn-primary btn-sm">Dodaj listę obecnosci</a>
    </div>
    <div class="col">
        <a asp-action="Details" asp-route-id="@ViewBag.group.Id" asp-route-typ="" class="btn btn-primary btn-sm">Powrót</a>
    </div>

</div>
<h3>Listy obecnosci z @ViewBag.course.Name </h3>

<table class="table table-sm">
    <thead>
    <th>Student</th>
        @foreach (var d in ViewBag.daty)
        {
        <th>@d</th>
        }
    </thead>
    <tbody>
        @foreach (var st in ViewBag.attnlist)
        {
            <tr>
                <td>@st.Student.IN</td>
                @foreach (var d in ViewBag.daty)
                {
                    if (st.Daty.Contains(d))
                    {
                        <td><b>X</b></td>
                    }
                    else
                    {
                        <td><b>-</b></td>
                    }
                }
            </tr>
        }
    </tbody>
</table>


